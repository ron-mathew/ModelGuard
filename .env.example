# Environment variable overrides for ModelGuard
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env to version control.

# MLflow configuration
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlruns/artifacts

# API configuration
API_HOST=0.0.0.0
API_PORT=5000
MODEL_GUARD_DASHBOARD_ONLY=false

# Monitoring thresholds
DRIFT_THRESHOLD=0.5
CHALLENGER_MIN_ROC_AUC=0.65
CHALLENGER_IMPROVEMENT_THRESHOLD=0.0

# Logging
LOG_LEVEL=INFO
