# ─────────────────────────────────────────────────────────────────────────────
# ModelGuard — single-container Render deployment
#
# Runs three processes under supervisord:
#   1. MLflow tracking server  (localhost:5001, internal only)
#   2. Flask prediction API    (localhost:5000, internal only)
#   3. Streamlit dashboard     (0.0.0.0:8501,  public — Render routes here)
#
# The mlruns/ directory (including mlflow.db and model artifacts) is baked
# into the image so no training step is needed at startup.
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim

LABEL maintainer="ModelGuard"
LABEL description="Drift-Aware MLOps Pipeline — Render single-container deployment"

# System deps: curl for health checks, supervisor for process management
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl supervisor \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    API_HOST=0.0.0.0 \
    API_PORT=5000 \
    MLFLOW_TRACKING_URI=http://localhost:5001 \
    MLFLOW_ARTIFACT_ROOT=/app/mlruns/artifacts \
    MODEL_GUARD_API_URL=http://localhost:5000

# Install Python dependencies first (better layer caching)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY src/ ./src/
COPY data/ ./data/
COPY scripts/ ./scripts/
COPY dashboard/ ./dashboard/

# Bake in the trained model registry and artifacts
# (mlruns/mlflow.db holds the champion alias; mlruns/artifacts holds model files)
COPY mlruns/ ./mlruns/
COPY artifacts/ ./artifacts/

# Copy supervisor config
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Create directories that may not exist in the repo
RUN mkdir -p \
    /app/reports/drift \
    /app/reports/monitoring \
    /app/data/simulated \
    /app/data/reference \
    /var/log/supervisor

# Render routes external traffic to this port
EXPOSE 8501

# Health check against the Streamlit health endpoint
HEALTHCHECK --interval=30s --timeout=15s --start-period=90s --retries=5 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
